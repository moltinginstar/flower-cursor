#!/bin/sh
# Kitty `shell` launcher: start the user's own shell under the flower cursor.
#
# Every new Kitty window runs this, so it fails open. If the wrapper cannot be
# started for any reason - a missing interpreter, a half-finished checkout, a
# broken install - the window still comes up with the user's real shell in it,
# with Kitty's shell integration nested the same way the wrapper nests it.
set -u

# The same resolution as `user_shell` in src/flower_cursor/kitty_shell.py:
# $SHELL unless it names this wrapper, then the login shell out of the passwd
# database, then /bin/sh. The two have to agree, because which one runs a
# window depends only on whether Python could be started.
passwd_shell() {
    user=$(id -un 2>/dev/null) || return 0
    if command -v getent > /dev/null 2>&1; then
        getent passwd "$user" 2> /dev/null | awk -F: 'NR == 1 { print $7 }'
    elif command -v dscl > /dev/null 2>&1; then
        dscl . -read "/Users/$user" UserShell 2> /dev/null | awk 'NR == 1 { print $2 }'
    fi
}

real_shell() {
    case "${SHELL##*/}" in
        ''|flower-cursor|flower-cursor-shell)
            shell=$(passwd_shell)
            [ -n "$shell" ] && echo "$shell" || echo "/bin/sh"
            ;;
        *) echo "$SHELL" ;;
    esac
}

kitten_exe() {
    if [ -n "${KITTY_INSTALLATION_DIR-}" ]; then
        # The same candidates, in the same order, as `kitten_executable` in
        # src/flower_cursor/kitty_shell.py.
        for candidate in \
            "$KITTY_INSTALLATION_DIR/../../MacOS/kitten" \
            "$KITTY_INSTALLATION_DIR/../../bin/kitten" \
            "$KITTY_INSTALLATION_DIR/../bin/kitten" \
            "$KITTY_INSTALLATION_DIR/kitten"; do
            [ -x "$candidate" ] && [ -f "$candidate" ] && { echo "$candidate"; return 0; }
        done
    fi
    command -v kitten 2>/dev/null
}

# Hand the window straight to the shell, integration and all. This is both the
# documented off switch and the recovery path.
plain_shell() {
    shell=$(real_shell)
    kitten=$(kitten_exe)
    if [ -n "$kitten" ]; then
        exec "$kitten" run-shell --shell "$shell"
    fi
    exec "$shell" -l -i
}

# Kitty opens a window by running this with no arguments. Anything else is
# Kitty using the `shell` option as a shell - `env read_from_shell` runs
# `<shell> -l -i -c 'command env -0'` to collect variables - and has to be
# answered by the real shell, not by a flower session that never returns.
#
# Kitty gives that read 1.5 seconds total, and a login+interactive zsh with a
# framework in it can take most of that on a cold start, so this branch comes
# before any other work in the script and forks nothing on the way.
if [ "$#" -gt 0 ]; then
    # Deliberately not `real_shell`: this branch is on Kitty's 1.5 s budget for
    # `env read_from_shell`, and a passwd lookup forks. $SHELL is set for all
    # but the pathological case this guards against.
    case "${SHELL##*/}" in
        ''|flower-cursor|flower-cursor-shell) exec /bin/sh "$@" ;;
        *) exec "$SHELL" "$@" ;;
    esac
fi

[ "${FLOWER_CURSOR_DISABLE-0}" = "0" ] || plain_shell

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ -x "$ROOT/.venv/bin/flower-cursor" ]; then
    exec "$ROOT/.venv/bin/flower-cursor" --kitty-shell
elif [ -x "$ROOT/.venv/bin/python" ]; then
    PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
        exec "$ROOT/.venv/bin/python" -m flower_cursor.observer --render --kitty-shell
elif command -v flower-cursor >/dev/null 2>&1; then
    exec flower-cursor --kitty-shell
fi

plain_shell
